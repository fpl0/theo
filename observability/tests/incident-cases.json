  {
    "name": "Readable empty inventory is an observed zero",
    "rule_uid": "theo-codex-auth",
    "input_series": [
      {
        "series": "theo_database_readable{environment=\"production\"}",
        "values": "1x20"
      }
    ],
    "expected": [
      {
        "labels": "{environment=\"production\"}",
        "value": 0
      }
    ]
  },
  {
    "name": "A blocked job requires one model-access incident",
    "rule_uid": "theo-codex-auth",
    "input_series": [
      {
        "series": "theo_database_readable{environment=\"production\"}",
        "values": "1x20"
