  {
    "name": "Healthy laptop cannot hide unavailable production core",
    "rule_uid": "theo-core-unavailable",
    "input_series": [
      {
        "series": "theo_database_readable{environment=\"production\"}",
        "values": "1x20"
      },
      {
        "series": "theo_database_readable{environment=\"local\"}",
        "values": "1x20"
      },
      {
        "series": "theo_core_ready{environment=\"production\"}",
        "values": "0x20"
      },
      {
        "series": "theo_core_ready{environment=\"local\"}",
        "values": "1x20"
      }
    ],
    "expected": [
      {
        "labels": "{environment=\"local\"}",
        "value": 0
      },
      {
        "labels": "{environment=\"production\"}",
        "value": 1
      }
    ]
  },
