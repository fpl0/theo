+	// Only the hypervisor host can issue administrative guest commands. A guest
+	// process can otherwise connect to its own CID and inherit this agent's UID.
+	for {
+		fd, _, err := unix.Accept(int(listener.file.Fd()))
+		if err != nil {
+			return nil, err
+		}
+		file := os.NewFile(uintptr(fd), "vsock")
+		peerName, err := unix.Getpeername(fd)
+		if err != nil {
+			file.Close()
+			return nil, fmt.Errorf("failed to get AF_VSOCK peer identity: %w", err)
+		}
+		peer, ok := peerName.(*unix.SockaddrVM)
+		if !ok || peer.CID != unix.VMADDR_CID_HOST {
+			file.Close()
+			continue
+		}
+		if err := unix.SetNonblock(fd, true); err != nil {
+			file.Close()
+			return nil, err
+		}
+		return &conn{file: file, localPort: listener.port, remotePort: peer.Port}, nil
